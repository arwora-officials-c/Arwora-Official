<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="20dp">

    <!-- Floating Detached Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_nav_card"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/nav_floating_bg_translucent"
        app:cardCornerRadius="32dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/nav_floating_stroke_translucent"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- 1. Home Item -->
            <LinearLayout
                android:id="@+id/nav_item_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_nav_home"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/nav_active_color" />

                <TextView
                    android:id="@+id/tv_nav_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Home"
                    android:textColor="@color/nav_active_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Search Item -->
            <LinearLayout
                android:id="@+id/nav_item_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_nav_search"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_nav_search"
                    app:tint="@color/nav_inactive_color" />

                <TextView
                    android:id="@+id/tv_nav_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Search"
                    android:textColor="@color/nav_inactive_color"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3. Center Spacer / Label for FAB -->
            <FrameLayout
                android:id="@+id/nav_item_center_placeholder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false">

                <TextView
                    android:id="@+id/tv_nav_create"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="6dp"
                    android:text="Create"
                    android:textColor="@color/nav_inactive_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 4. Inbox Item -->
            <LinearLayout
                android:id="@+id/nav_item_inbox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_nav_inbox"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inbox"
                    android:src="@drawable/ic_nav_inbox"
                    app:tint="@color/nav_inactive_color" />

                <TextView
                    android:id="@+id/tv_nav_inbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Inbox"
                    android:textColor="@color/nav_inactive_color"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 5. Profile Item -->
            <LinearLayout
                android:id="@+id/nav_item_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_nav_profile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Profile"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/nav_inactive_color" />

                <TextView
                    android:id="@+id/tv_nav_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Profile"
                    android:textColor="@color/nav_inactive_color"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Prominent Centered Overflowing Floating Action Button (Create / Plus) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_nav_create"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/nav_fab_bg"
        app:cardCornerRadius="27dp"
        app:cardElevation="14dp"
        app:rippleColor="#80FFFFFF"
        app:strokeColor="@color/white"
        app:strokeWidth="2.5dp"
        app:layout_constraintBottom_toTopOf="@+id/floating_nav_card"
        app:layout_constraintTop_toTopOf="@+id/floating_nav_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="Create"
            android:src="@drawable/ic_nav_create"
            app:tint="@color/nav_fab_icon" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
