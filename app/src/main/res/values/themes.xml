<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ArworaHyperToolkit" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:colorBackground">@color/colorSurface</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:statusBarColor">@color/colorSurface</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.MyApplication" parent="Theme.ArworaHyperToolkit" />

    <!-- Official Android 12+ SplashScreen theme with backward compatibility. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="windowSplashScreenBackground">@color/colorSurface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_arwora_wordmark</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@color/colorSurface</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/Theme.ArworaHyperToolkit</item>
    </style>

    <style name="Theme.Splash" parent="Theme.App.Starting" />
</resources>
